# Variables usadas por docker-compose.yml para el servicio Postgres local
# (solo aplica si backend/.env apunta su DATABASE_URL a "postgres:5432").
# Copiar a ".env" en la raíz y completar con valores propios.
POSTGRES_USER=consultar_campo_admin
POSTGRES_PASSWORD=cambiar-por-una-contrasena-fuerte
POSTGRES_DB=consultar_campo
