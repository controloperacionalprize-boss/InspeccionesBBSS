APP_ENV=development
DATABASE_URL=postgresql://usuario:password@localhost:5432/consultar_campo
CORS_ORIGINS=http://localhost:5173

# Generar uno propio con: python -c "import secrets; print(secrets.token_hex(32))"
# La app rechaza este valor de ejemplo y no arranca si se usa tal cual.
JWT_SECRET_KEY=cambiar-esta-clave-en-produccion
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
